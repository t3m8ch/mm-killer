import { implement } from "@orpc/server";
import { eq } from "drizzle-orm";
import { transaction, {{#if updatedBy}}authed, {{/if}}type Context } from "../../platform";
import { contract } from "./contract";
import { {{camelCase name}} } from "./schema";

// plop:imports
const os = implement(contract).$context<Context>();

const serialize = (row: typeof {{camelCase name}}.$inferSelect) => ({
  ...row,
  createdAt: row.createdAt.toISOString(),
{{#if updatedAt}}
  updatedAt: row.updatedAt?.toISOString() ?? null,
{{/if}}
});

export const api = {
  // plop:handlers
{{#if audit}}
  update: os.update{{#if updatedBy}}.use(authed){{/if}}.use(transaction).handler(async ({ input, context, errors }) => {
    const [entry] = await context.db.update({{camelCase name}}).set({
      // Добавить предметные изменения; поля аудита задаются только сервером.
{{#if updatedAt}}
      updatedAt: context.now(),
{{/if}}
{{#if updatedBy}}
      updatedBy: context.user.id,
{{/if}}
    }).where(eq({{camelCase name}}.id, input.id)).returning();

    if (!entry) {
      throw errors.NOT_FOUND();
    }

    return serialize(entry);
  }),
{{else}}
  // Добавить предметные поля и реализацию обновления перед использованием.
  update: os.update.handler(({ errors }) => {
    throw errors.NOT_IMPLEMENTED();
  }),
{{/if}}
  delete: os.delete.use(transaction).handler(async ({ input, context, errors }) => {
    const [entry] = await context.db.delete({{camelCase name}}).where(eq({{camelCase name}}.id, input.id)).returning();

    if (!entry) {
      throw errors.NOT_FOUND();
    }

    return { deleted: true };
  }),
  create: os.create.use(transaction).handler(async ({ context }) => {
    const [entry] = await context.db
      .insert({{camelCase name}})
      .values({ createdAt: context.now() })
      .returning();

    return serialize(entry);
  }),
  list: os.list.handler(async ({ context }) =>
    (await context.db.select().from({{camelCase name}}).orderBy({{camelCase name}}.id)).map(serialize),
  ),
  get: os.get.handler(async ({ input, context, errors }) => {
    const [entry] = await context.db.select().from({{camelCase name}}).where(eq({{camelCase name}}.id, input.id));

    if (!entry) {
      throw errors.NOT_FOUND();
    }

    return serialize(entry);
  }),
};
