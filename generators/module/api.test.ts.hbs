import { it, expect } from "vitest";
import { createRouterClient } from "@orpc/server";
import { rollbackTest, clock } from "../../../tests/helpers/database";
import { api } from "./index";
it("сохраняет запись через публичный API", () =>
  rollbackTest(async (context) => {
    const time = clock();
    const client = createRouterClient(api, { context: { ...context, now: time.now{{#if updatedBy}}, userId: 17{{/if}} } });
    const entry = await client.create({});
    expect(await client.get({ id: entry.id })).toEqual({
      id: entry.id,
      createdAt: "2026-11-04T12:00:00.000Z",
{{#if updatedAt}}
      updatedAt: null,
{{/if}}
{{#if updatedBy}}
      updatedBy: null,
{{/if}}
    });
    expect(await client.list()).toContainEqual(entry);
{{#if audit}}
    time.set("2026-11-05T15:00:00.000Z");
    const input = { id: entry.id, updatedAt: "2000-01-01T00:00:00.000Z", updatedBy: 999 };
    const updated = await client.update(input);
    expect(updated).toEqual({
      id: entry.id,
      createdAt: "2026-11-04T12:00:00.000Z",
{{#if updatedAt}}
      updatedAt: "2026-11-05T15:00:00.000Z",
{{/if}}
{{#if updatedBy}}
      updatedBy: 17,
{{/if}}
    });
    expect(await client.get({ id: entry.id })).toEqual(updated);
    await expect(client.update({ id: 2147483647 })).rejects.toMatchObject({ code: "NOT_FOUND" });
{{#if updatedBy}}
    const anonymous = createRouterClient(api, { context });
    await expect(anonymous.update({ id: entry.id })).rejects.toMatchObject({ code: "UNAUTHORIZED" });
    expect(await client.get({ id: entry.id })).toEqual(updated);
{{/if}}
{{else}}
    await expect(client.update({ id: entry.id })).rejects.toMatchObject({ code: "NOT_IMPLEMENTED" });
{{/if}}
    expect(await client.delete({ id: entry.id })).toEqual({ deleted: true });
    await expect(client.get({ id: entry.id })).rejects.toMatchObject({ code: "NOT_FOUND" });
  }));
