{
  "name": "mm-killer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/tooling/oxlint-plugin.test.js && node tests/tooling/test-generated.js",
    "lint": "oxlint",
    "typecheck": "oxlint --type-aware --type-check",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore",
    "format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check",
    "unused": "knip",
    "db:seed": "node scripts/seed.ts",
    "test:api": "vitest run",
    "db:migrate": "node scripts/migrate.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "boundaries": "easement check",
    "generate": "node scripts/generate.js",
    "test:guards": "node tests/tooling/verify-guards.js",
    "db:generate": "drizzle-kit generate",
    "start": "node .output/server/index.mjs",
    "test:runtime": "node --test tests/tooling/runtime.test.js",
    "test:bundle": "node tests/tooling/verify-client-bundle.js",
    "prototype": "mise exec -- vite --host 0.0.0.0 --port 4174"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/tanstack-query": "1.16.1",
    "@phosphor-icons/react": "2.1.10",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@sourcegraph/scip-typescript": "0.6.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "1.0.0-rc.5",
    "knip": "6.44.1",
    "nitro": "3.0.261103-rc",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "plop": "4.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.28.10"
}
